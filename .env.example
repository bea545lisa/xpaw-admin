# Shopify App Credentials
# Get these from your Shopify Partner Dashboard
SHOPIFY_API_KEY=
VITE_SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Your app URL (e.g. https://your-tunnel-url.trycloudflare.com)
#SHOPIFY_APP_URL=

# Required Shopify API scopes
#SCOPES=write_products,read_products

# Optional: Custom shop domain
# SHOP_CUSTOM_DOMAIN=

# Optional: Port
PORT=3000
