# Shopify App Credentials
# Get these from your Shopify Partner Dashboard
SHOPIFY_API_KEY=
VITE_SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Your app URL (e.g. https://your-tunnel-url.trycloudflare.com)
#SHOPIFY_APP_URL=

# Required Shopify API scopes
#SCOPES=write_products,read_products

# Optional: Custom shop domain
# SHOP_CUSTOM_DOMAIN=

# Optional: Port
PORT=3000

# Optional: DeepL API key for auto-translate (https://www.deepl.com/pro-api)
# Free-tier keys end in ":fx"
DEEPL_API_KEY=

# Optional: comma-separated allowlist of staff emails allowed to save/delete.
# Everyone else with app access gets a read-only view. Leave empty to allow all.
EDITOR_EMAILS=
